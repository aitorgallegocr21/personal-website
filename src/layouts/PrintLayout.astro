---
import '@/styles/global.css';
import { cvData } from '@/data/cv-data';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${cvData.personal.name} - Curriculum Vitae`,
  description = cvData.about.shortSummary,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      @page {
        size: A4 portrait;
        margin: 10mm 12mm;
      }

      @media print {
        body {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
      }
    </style>
  </head>
  <body class="bg-white text-zinc-900 font-sans antialiased selection:bg-zinc-200">
    <main class="max-w-[210mm] mx-auto p-0 min-h-screen print:min-h-0">
      <slot />
    </main>
  </body>
</html>
