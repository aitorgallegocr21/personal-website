---
import '@/styles/global.css';
import { cvData } from '@/data/cv-data';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${cvData.personal.name} - Curriculum Vitae`,
  description = cvData.about.shortSummary,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Typography (Synchronized Inter & JetBrains Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Palette Initialization (Zero-FOUC & URL Param Support) -->
    <script is:inline>
      (function () {
        try {
          const VALID_PALETTES = ['emerald', 'slate', 'sky', 'violet', 'rose', 'monochrome'];
          const params = new URLSearchParams(window.location.search);
          const urlPalette = params.get('palette');
          const storedPalette = localStorage.getItem('portfolio-palette');

          let activePalette = 'emerald';
          if (urlPalette && VALID_PALETTES.includes(urlPalette)) {
            activePalette = urlPalette;
          } else if (storedPalette && VALID_PALETTES.includes(storedPalette)) {
            activePalette = storedPalette;
          }

          document.documentElement.setAttribute('data-palette', activePalette);
          document.documentElement.dataset.palette = activePalette;
        } catch (e) {
          document.documentElement.setAttribute('data-palette', 'emerald');
          document.documentElement.dataset.palette = 'emerald';
        }
      })();
    </script>

    <style is:global>
      @page {
        size: A4 portrait;
        margin: 8mm 10mm;
      }

      @media print {
        html, body {
          width: 100% !important;
          height: auto !important;
          max-height: 100% !important;
          margin: 0 !important;
          padding: 0 !important;
          background: #ffffff !important;
          overflow: hidden !important;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        #cv-container {
          page-break-inside: avoid !important;
          break-inside: avoid !important;
        }

        /* Prevent link URLs from being printed next to anchors */
        a[href]:after {
          content: "" !important;
        }
      }
    </style>
  </head>
  <body class="bg-zinc-100 print:bg-white text-zinc-900 font-sans antialiased selection:bg-zinc-200 overflow-x-auto print:overflow-hidden">
    <div class="min-w-fit md:min-w-0 flex justify-center p-2 sm:p-6 md:p-8 print:p-0 print:m-0">
      <main class="w-[210mm] max-w-[210mm] min-h-[297mm] p-[10mm_12mm] print:p-0 print:m-0 print:w-full print:max-w-none bg-white print:bg-transparent shadow-xl print:shadow-none print:min-h-0 print:h-auto shrink-0 transition-shadow">
        <slot />
      </main>
    </div>
  </body>
</html>
