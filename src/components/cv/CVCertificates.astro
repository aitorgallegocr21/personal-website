---
import { cvData } from '@/data/cv-data';
import { Award } from 'lucide-astro';

interface Props {
  title?: string;
}

const { title = 'Certificaciones Clave' } = Astro.props;

const featuredCertificates = cvData.certificates.filter((cert) => cert.featuredInCV);
---

{
  featuredCertificates.length > 0 && (
    <section class="break-inside-avoid">
      <h2 class="text-xs font-bold uppercase tracking-wider text-zinc-900 border-b border-zinc-200/90 pb-1 mb-2.5 print:mb-1.5 flex items-center gap-1.5">
        <span class="w-1.5 h-3.5 rounded-xs bg-[var(--color-accent)] shrink-0" />
        <span>{title}</span>
      </h2>

      <div class="flex flex-wrap gap-1.5 print:gap-1">
        {featuredCertificates.map((cert) => {
          const docUrl = cert.documentUrl
            ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}${cert.documentUrl}`
            : undefined;

          return docUrl ? (
            <a
              href={docUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-1.5 px-2.5 py-1 print:px-2 print:py-0.5 rounded text-[10px] font-medium bg-zinc-50 text-zinc-800 border border-zinc-200/90 hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] hover:bg-[var(--color-accent-subtle)] transition-colors print:bg-zinc-50 print:text-zinc-800 print:border-zinc-300"
              title={`Ver credencial oficial: ${cert.title}`}
            >
              <Award class="w-3 h-3 text-[var(--color-accent)] shrink-0" />
              <span>{cert.title}</span>
            </a>
          ) : (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 print:px-2 print:py-0.5 rounded text-[10px] font-medium bg-zinc-50 text-zinc-800 border border-zinc-200/90">
              <Award class="w-3 h-3 text-zinc-400 shrink-0" />
              <span>{cert.title}</span>
            </span>
          );
        })}
      </div>
    </section>
  )
}
