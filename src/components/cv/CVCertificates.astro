---
import { cvData } from '@/data/cv-data';

interface Props {
  title?: string;
}

const { title = 'Certificaciones & Especialización' } = Astro.props;

const featuredCertificates = cvData.certificates.filter((cert) => cert.featuredInCV);
---

{
  featuredCertificates.length > 0 && (
    <section class="mb-3 break-inside-avoid">
      <h2 class="text-xs font-bold uppercase tracking-wider text-zinc-900 border-b border-zinc-200 pb-0.5 mb-1.5">
        {title}
      </h2>

      <div class="space-y-1.5">
        {featuredCertificates.map((cert) => (
          <article class="break-inside-avoid text-[11px]">
            <div class="flex items-baseline justify-between gap-2">
              <div class="min-w-0">
                <h3 class="font-semibold text-zinc-900 inline">
                  {cert.title}
                </h3>
                <span class="text-zinc-700 font-medium"> · {cert.issuer}</span>
                {cert.platform && (
                  <span class="text-zinc-500 font-normal"> ({cert.platform})</span>
                )}
              </div>
              {cert.hours && (
                <span class="font-mono text-zinc-500 text-[10.5px] shrink-0">
                  {cert.hours}
                </span>
              )}
            </div>

            {cert.summary && (
              <p class="text-zinc-600 leading-snug mt-0.5 text-pretty">
                {cert.summary}
              </p>
            )}
          </article>
        ))}
      </div>
    </section>
  )
}
