---
import { cvData } from '@/data/cv-data';

interface Props {
  title?: string;
}

const { title = 'Certificaciones Clave' } = Astro.props;

const featuredCertificates = cvData.certificates.filter((cert) => cert.featuredInCV);
---

{
  featuredCertificates.length > 0 && (
    <section class="break-inside-avoid">
      <h2 class="text-[11px] font-bold uppercase tracking-wider text-zinc-900 border-b border-zinc-200/90 pb-1 mb-2 flex items-center gap-1.5">
        <span class="w-1 h-3 rounded-xs bg-[var(--color-accent)] shrink-0" />
        <span>{title}</span>
      </h2>

      <div class="space-y-1.5">
        {featuredCertificates.map((cert) => (
          <article class="break-inside-avoid text-[10px] border-l-2 border-zinc-200 hover:border-[var(--color-accent)] pl-2 transition-colors print:border-zinc-300">
            <div class="flex items-baseline justify-between gap-1">
              <div class="min-w-0">
                {cert.documentUrl ? (
                  <a
                    href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${cert.documentUrl}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-zinc-900 inline hover:text-[var(--color-accent)] hover:underline"
                    title="Ver credencial oficial (PDF)"
                  >
                    {cert.title}
                  </a>
                ) : (
                  <h3 class="font-semibold text-zinc-900 inline">
                    {cert.title}
                  </h3>
                )}
              </div>
              {cert.hours && (
                <span class="font-mono text-zinc-500 text-[9px] shrink-0">
                  {cert.hours}
                </span>
              )}
            </div>
            <div class="text-[9px] text-zinc-500 font-mono">
              {cert.issuer} {cert.platform ? `· ${cert.platform}` : ''}
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}
