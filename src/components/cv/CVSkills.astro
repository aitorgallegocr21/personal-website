---
import { cvData } from '@/data/cv-data';

interface Props {
  title?: string;
}

const { title = 'Habilidades Técnicas' } = Astro.props;
const { skills } = cvData;
---

{
  skills && skills.length > 0 && (
    <section class="break-inside-avoid">
      <h2 class="text-xs font-bold uppercase tracking-wider text-zinc-900 border-b border-zinc-200/90 pb-1 mb-2.5 print:mb-1.5 flex items-center gap-1.5">
        <span class="w-1.5 h-3.5 rounded-xs bg-[var(--color-accent)] shrink-0" />
        <span>{title}</span>
      </h2>

      <div class="space-y-2.5 print:space-y-1.5">
        {skills.map((group) => (
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-700 block mb-1 print:mb-0.5">
              {group.category}
            </span>
            <div class="flex flex-wrap gap-1">
              {group.skills.map((skill) => (
                <span class="text-[9.5px] font-mono bg-zinc-100 hover:bg-[var(--color-accent-subtle)] hover:text-[var(--color-accent)] text-zinc-800 px-2 py-0.5 print:px-1.5 print:py-0.2 rounded border border-zinc-200/80 hover:border-[var(--color-accent-border)] transition-colors print:border-zinc-300">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}
