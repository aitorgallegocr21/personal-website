---
import { cvData } from '@/data/cv-data';

interface Props {
  title?: string;
}

const { title = 'Habilidades Técnicas' } = Astro.props;
const { skills } = cvData;
---

{
  skills && skills.length > 0 && (
    <section class="mb-3 break-inside-avoid">
      <h2 class="text-xs font-bold uppercase tracking-wider text-zinc-900 border-b border-zinc-200 pb-0.5 mb-1.5">
        {title}
      </h2>

      <div class="space-y-1">
        {skills.map((group) => (
          <div class="flex items-baseline gap-2 text-[11px] leading-relaxed">
            <span class="font-semibold text-zinc-900 shrink-0 w-40">
              {group.category}:
            </span>
            <span class="text-zinc-700">
              {group.skills.join(' · ')}
            </span>
          </div>
        ))}
      </div>
    </section>
  )
}
