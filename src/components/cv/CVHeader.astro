---
import { cvData } from '@/data/cv-data';
import PhoneContact from '@/components/ui/PhoneContact.astro';
import { MapPin, Mail, Github, Linkedin, Globe, ArrowUpRight } from 'lucide-astro';

const { personal, about } = cvData;

const avatarSrc = personal.avatarUrl
  ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}${personal.avatarUrl}`
  : undefined;
---

<header class="mb-3.5 pb-3 print:mb-2.5 print:pb-2 border-b border-zinc-200/90 break-inside-avoid">
  <!-- Dynamic Accent Stripe -->
  <div class="h-1 w-full bg-[var(--color-accent)] rounded-full mb-3 print:mb-2 print:h-1"></div>

  <div class="flex flex-col sm:flex-row items-start justify-between gap-3 sm:gap-4 print:flex-row print:items-start print:justify-between">
    <!-- Left Column: Avatar + Candidate Identity -->
    <div class="flex items-start gap-3.5 min-w-0 flex-1">
      {
        avatarSrc && (
          <div class="relative w-[23mm] h-[23mm] shrink-0 rounded-full overflow-hidden border border-zinc-200/90 ring-2 ring-[var(--color-accent-border)] shadow-xs bg-zinc-100 print:border-zinc-300 print:ring-1">
            <img
              src={avatarSrc}
              alt={personal.name}
              class="w-full h-full object-cover object-top print:contrast-[1.05]"
              loading="eager"
              decoding="sync"
            />
          </div>
        )
      }

      <div class="min-w-0 flex flex-col justify-center">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-xl sm:text-2xl font-black tracking-tight text-zinc-950 leading-none">
            {personal.name}
          </h1>
          {
            personal.status && (
              <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-medium bg-[var(--color-accent-subtle)] text-[var(--color-accent)] border border-[var(--color-accent-border)] leading-none shrink-0 print:border-zinc-300">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]" />
                <span>{personal.status}</span>
              </span>
            )
          }
        </div>

        <p class="text-xs font-bold uppercase tracking-wider text-[var(--color-accent)] mt-1">
          {personal.title}
        </p>

        {
          (about.cvSummary || about.shortSummary) && (
            <p class="text-[11px] text-zinc-600 leading-normal text-pretty mt-1.5 print:mt-1 max-w-[118mm]">
              {about.cvSummary || about.shortSummary}
            </p>
          )
        }
      </div>
    </div>

    <!-- Right Column: Minimalist Web Anchor & Semantic Contact Details -->
    <div class="shrink-0 w-full sm:w-auto print:w-auto flex flex-col items-start sm:items-end print:items-end">
      <!-- Minimalist & Modern Web Anchor -->
      {
        personal.website && (
          <a
            href={personal.website}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-[var(--color-accent-subtle)] hover:bg-[var(--color-accent)] text-[var(--color-accent)] hover:text-white border border-[var(--color-accent-border)] transition-all duration-200 shadow-2xs font-medium text-[11px] mb-2.5 print:mb-1.5 print:bg-zinc-50 print:text-zinc-900 print:border-zinc-300"
            title="Abrir portafolio interactivo en línea"
          >
            <Globe class="w-3.5 h-3.5 text-[var(--color-accent)] group-hover:text-white print:text-zinc-700 shrink-0" />
            <span class="tracking-tight">Web Personal</span>
            <ArrowUpRight class="w-3.5 h-3.5 shrink-0 opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
          </a>
        )
      }

      <ul class="flex flex-col gap-1 print:gap-0.5 text-[10.5px] text-zinc-600 font-mono sm:items-end print:items-end">
        {
          personal.location && (
            <li class="inline-flex items-center gap-1.5">
              <MapPin class="w-3 h-3 text-zinc-400 shrink-0" />
              <span>{personal.location}</span>
            </li>
          )
        }

        {
          personal.email && (
            <li class="inline-flex items-center gap-1.5">
              <Mail class="w-3 h-3 text-zinc-400 shrink-0" />
              <a
                href={`mailto:${personal.email}`}
                class="hover:text-zinc-900 hover:underline"
                title={`Enviar correo a ${personal.email}`}
              >
                {personal.email}
              </a>
            </li>
          )
        }

        {
          personal.phone && (
            <li class="inline-flex items-center gap-1.5">
              <PhoneContact phone={personal.phone} mode="auto" />
            </li>
          )
        }

        <li class="inline-flex items-center gap-3 pt-0.5">
          {
            personal.github && (
              <a
                href={personal.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 hover:text-zinc-900 hover:underline"
                title="Perfil de GitHub"
              >
                <Github class="w-3 h-3 text-zinc-400 shrink-0" />
                <span>GitHub ↗</span>
              </a>
            )
          }

          {
            personal.linkedin && (
              <a
                href={personal.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 hover:text-zinc-900 hover:underline"
                title="Perfil de LinkedIn"
              >
                <Linkedin class="w-3 h-3 text-zinc-400 shrink-0" />
                <span>LinkedIn ↗</span>
              </a>
            )
          }
        </li>
      </ul>
    </div>
  </div>
</header>
