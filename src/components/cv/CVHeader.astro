---
import { cvData } from '@/data/cv-data';
import PhoneContact from '@/components/ui/PhoneContact.astro';
import { MapPin, Mail, Github, Linkedin, ExternalLink, Sparkles } from 'lucide-astro';

const { personal, about } = cvData;

const getGithubHandle = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const getLinkedinHandle = (url: string) => {
  const match = url.match(/(?:linkedin\.com\/in\/)([^/]+)/);
  return match ? `in/${match[1]}` : url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
};

const avatarSrc = personal.avatarUrl
  ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}${personal.avatarUrl}`
  : undefined;
---

<header class="mb-3 pb-3 border-b border-zinc-200/90 break-inside-avoid">
  <!-- Dynamic Accent Stripe -->
  <div class="h-1 w-full bg-[var(--color-accent)] rounded-full mb-3 print:h-1"></div>

  <div class="flex flex-col sm:flex-row items-start justify-between gap-3 sm:gap-4 print:flex-row print:items-start print:justify-between">
    <!-- Left Column: Avatar + Candidate Identity -->
    <div class="flex items-start gap-3.5 min-w-0 flex-1">
      {
        avatarSrc && (
          <div class="relative w-[24mm] h-[24mm] shrink-0 rounded-full overflow-hidden border border-zinc-200/90 ring-2 ring-[var(--color-accent-border)] shadow-xs bg-zinc-100 print:border-zinc-300 print:ring-1">
            <img
              src={avatarSrc}
              alt={personal.name}
              class="w-full h-full object-cover object-top print:contrast-[1.05]"
              loading="eager"
              decoding="sync"
            />
          </div>
        )
      }

      <div class="min-w-0 flex flex-col justify-center">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-xl sm:text-2xl font-black tracking-tight text-zinc-950 leading-none">
            {personal.name}
          </h1>
          {
            personal.status && (
              <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-medium bg-[var(--color-accent-subtle)] text-[var(--color-accent)] border border-[var(--color-accent-border)] leading-none shrink-0 print:border-zinc-300">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]" />
                <span>{personal.status}</span>
              </span>
            )
          }
        </div>

        <p class="text-xs font-bold uppercase tracking-wider text-[var(--color-accent)] mt-1">
          {personal.title}
        </p>

        {
          about.shortSummary && (
            <p class="text-[10px] text-zinc-600 leading-snug line-clamp-3 text-pretty mt-1 max-w-[115mm]">
              {about.shortSummary}
            </p>
          )
        }
      </div>
    </div>

    <!-- Right Column: Prominent Web Portfolio Anchor & Contact Details -->
    <div class="shrink-0 w-full sm:w-auto print:w-auto flex flex-col items-start sm:items-end print:items-end">
      <!-- Prominent Web Portfolio Interactive Anchor -->
      {
        personal.website && (
          <a
            href={personal.website}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center justify-between gap-2 px-2.5 py-1.5 rounded-lg bg-[var(--color-accent-subtle)] hover:bg-[var(--color-accent)] text-[var(--color-accent)] hover:text-white border border-[var(--color-accent-border)] transition-all shadow-2xs print:bg-zinc-100 print:text-zinc-900 print:border-zinc-300 mb-2"
            title="Abrir portafolio interactivo en línea"
          >
            <div class="flex items-center gap-1.5">
              <Sparkles class="w-3.5 h-3.5 text-[var(--color-accent)] group-hover:text-white print:text-zinc-700 shrink-0" />
              <div class="flex flex-col text-left">
                <span class="text-[8px] uppercase tracking-wider font-mono opacity-80 leading-none">Ver en vivo</span>
                <span class="text-[10px] font-bold leading-tight">✦ Portfolio Web Interactivo</span>
              </div>
            </div>
            <ExternalLink class="w-3 h-3 shrink-0 opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 transition-transform" />
          </a>
        )
      }

      <ul class="flex flex-col gap-1 text-[10px] text-zinc-600 font-mono sm:items-end print:items-end">
        {
          personal.location && (
            <li class="inline-flex items-center gap-1.5">
              <MapPin class="w-3 h-3 text-zinc-400 shrink-0" />
              <span>{personal.location}</span>
            </li>
          )
        }

        {
          personal.email && (
            <li class="inline-flex items-center gap-1.5">
              <Mail class="w-3 h-3 text-zinc-400 shrink-0" />
              <a
                href={`mailto:${personal.email}`}
                class="hover:text-zinc-900 hover:underline"
                title={`Enviar correo a ${personal.email}`}
              >
                {personal.email}
              </a>
            </li>
          )
        }

        {
          personal.phone && (
            <li class="inline-flex items-center gap-1.5">
              <PhoneContact phone={personal.phone} mode="auto" />
            </li>
          )
        }

        {
          personal.github && (
            <li class="inline-flex items-center gap-1.5">
              <Github class="w-3 h-3 text-zinc-400 shrink-0" />
              <a
                href={personal.github}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-zinc-900 hover:underline"
                title="Perfil de GitHub"
              >
                {getGithubHandle(personal.github)}
              </a>
            </li>
          )
        }

        {
          personal.linkedin && (
            <li class="inline-flex items-center gap-1.5">
              <Linkedin class="w-3 h-3 text-zinc-400 shrink-0" />
              <a
                href={personal.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-zinc-900 hover:underline"
                title="Perfil de LinkedIn"
              >
                {getLinkedinHandle(personal.linkedin)}
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</header>
