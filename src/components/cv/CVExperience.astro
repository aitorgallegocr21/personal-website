---
import { cvData } from '@/data/cv-data';

interface Props {
  title?: string;
}

const { title = 'Experiencia' } = Astro.props;

const featuredExperience = cvData.experience.filter((exp) => exp.featuredInCV);
---

{
  featuredExperience.length > 0 && (
    <section class="mb-3.5">
      <h2 class="text-xs font-bold uppercase tracking-wider text-zinc-900 border-b border-zinc-200 pb-1 mb-2">
        {title}
      </h2>

      <div class="space-y-2.5">
        {featuredExperience.map((exp) => (
          <article class="break-inside-avoid">
            <div class="flex items-baseline justify-between gap-2">
              <div class="min-w-0">
                <h3 class="text-xs font-semibold text-zinc-900 inline">
                  {exp.role}
                </h3>
                <span class="text-xs font-medium text-zinc-700"> · {exp.company}</span>
                {exp.location && (
                  <span class="text-[11px] text-zinc-500 font-normal"> ({exp.location})</span>
                )}
              </div>
              <span class="text-[11px] font-mono text-zinc-500 shrink-0">
                {exp.startDate} — {exp.endDate || 'Actualidad'}
              </span>
            </div>

            {exp.bullets && exp.bullets.length > 0 && (
              <ul class="mt-1 space-y-0.5 text-[11px] leading-relaxed text-zinc-700 list-disc list-outside ml-3.5">
                {exp.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}

            {exp.technologies && exp.technologies.length > 0 && (
              <div class="mt-1 flex flex-wrap gap-1">
                {exp.technologies.map((tech) => (
                  <span class="text-[10px] font-mono bg-zinc-100 text-zinc-700 px-1.5 py-0.5 rounded border border-zinc-200/60">
                    {tech}
                  </span>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>
  )
}
