---
import { cvData } from '@/data/cv-data';

interface Props {
  title?: string;
}

const { title = 'Educación & Formación Reglada' } = Astro.props;
const { education } = cvData;
const websiteUrl = cvData.personal.website;
---

{
  education && education.length > 0 && (
    <section class="break-inside-avoid">
      <h2 class="text-xs font-bold uppercase tracking-wider text-zinc-900 border-b border-zinc-200/90 pb-1 mb-2.5 print:mb-1.5 flex items-center gap-1.5">
        <span class="w-1.5 h-3.5 rounded-xs bg-[var(--color-accent)] shrink-0" />
        <span>{title}</span>
      </h2>

      <div class="space-y-2.5 print:space-y-2">
        {education.map((edu) => (
          <article class="break-inside-avoid border-l-2 border-[var(--color-accent-border)] hover:border-[var(--color-accent)] pl-2.5 transition-colors print:border-[var(--color-accent-border)]">
            <div class="leading-snug">
              <div class="flex items-baseline justify-between gap-1.5">
                <div class="min-w-0">
                  {edu.documentUrl ? (
                    <a
                      href={`${websiteUrl}/?doc=gm-smr#trayectoria`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-bold text-xs text-zinc-900 inline hover:text-[var(--color-accent)] hover:underline"
                      title="Ver titulación o certificado oficial de SMR en la web"
                    >
                      {edu.degree}
                    </a>
                  ) : (
                    <h3 class="font-bold text-xs text-zinc-900 inline">
                      {edu.degree}
                    </h3>
                  )}
                </div>
                <span class="text-[10px] font-mono text-zinc-500 shrink-0">
                  {edu.period}
                </span>
              </div>

              <div class="flex items-baseline justify-between text-[10.5px] text-zinc-600 mt-0.5">
                <span class="font-medium text-zinc-700">
                  {edu.institution.replace(/\s*\(.*\)/, '')}
                </span>
                {edu.grade && (
                  <span class="text-[10px] font-mono font-semibold text-[var(--color-accent-text)] bg-[var(--color-accent-subtle)] px-1.5 py-0.2 rounded border border-[var(--color-accent-border)] print:border-zinc-300 shrink-0">
                    {edu.grade}
                  </span>
                )}
              </div>
            </div>

            {edu.details && edu.details.length > 0 && (
              <ul class="mt-1 space-y-0.5 text-[10.5px] text-zinc-600 leading-snug list-disc list-outside ml-3">
                {edu.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>
  )
}
