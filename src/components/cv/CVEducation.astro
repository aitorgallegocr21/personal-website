---
import { cvData } from '@/data/cv-data';

interface Props {
  title?: string;
}

const { title = 'Educación & Formación Reglada' } = Astro.props;
const { education } = cvData;
---

{
  education && education.length > 0 && (
    <section class="mb-3 break-inside-avoid">
      <h2 class="text-xs font-bold uppercase tracking-wider text-zinc-900 border-b border-zinc-200 pb-0.5 mb-1.5 flex items-center gap-1.5">
        <span class="w-1 h-3 rounded-xs bg-[var(--color-accent)] shrink-0" />
        <span>{title}</span>
      </h2>

      <div class="space-y-2">
        {education.map((edu) => (
          <article class="break-inside-avoid text-[10.5px]">
            <div class="flex items-baseline justify-between gap-2">
              <div class="min-w-0">
                {edu.documentUrl ? (
                  <a
                    href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${edu.documentUrl}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-zinc-900 inline hover:text-[var(--color-accent)] hover:underline"
                    title="Ver titulación o certificado oficial"
                  >
                    {edu.degree}
                  </a>
                ) : (
                  <h3 class="font-semibold text-zinc-900 inline">
                    {edu.degree}
                  </h3>
                )}
                <span class="text-zinc-700 font-medium"> · {edu.institution}</span>
              </div>
              <span class="font-mono text-zinc-500 text-[10px] shrink-0">
                {edu.period}
              </span>
            </div>

            {edu.details && edu.details.length > 0 && (
              <ul class="mt-0.5 space-y-0.5 text-zinc-600 leading-snug list-disc list-outside ml-3.5">
                {edu.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>
  )
}
