---
import { cvData } from '@/data/cv-data';

interface Props {
  title?: string;
}

const { title = 'Educación & Formación Reglada' } = Astro.props;
const { education } = cvData;
---

{
  education && education.length > 0 && (
    <section class="break-inside-avoid">
      <h2 class="text-[11px] font-bold uppercase tracking-wider text-zinc-900 border-b border-zinc-200/90 pb-1 mb-2 flex items-center gap-1.5">
        <span class="w-1 h-3 rounded-xs bg-[var(--color-accent)] shrink-0" />
        <span>{title}</span>
      </h2>

      <div class="space-y-2">
        {education.map((edu) => (
          <article class="break-inside-avoid border-l-2 border-zinc-200 hover:border-[var(--color-accent)] pl-2 transition-colors print:border-zinc-300">
            <div class="flex items-baseline justify-between gap-1">
              <div class="min-w-0">
                {edu.documentUrl ? (
                  <a
                    href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${edu.documentUrl}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-bold text-[10.5px] text-zinc-900 inline hover:text-[var(--color-accent)] hover:underline"
                    title="Ver titulación o certificado oficial"
                  >
                    {edu.degree}
                  </a>
                ) : (
                  <h3 class="font-bold text-[10.5px] text-zinc-900 inline">
                    {edu.degree}
                  </h3>
                )}
              </div>
            </div>

            <div class="flex items-center justify-between text-[9px] text-zinc-500 font-mono mt-0.5">
              <span>{edu.institution.replace(/\s*\(.*\)/, '')}</span>
              <span>{edu.period}</span>
            </div>

            {edu.details && edu.details.length > 0 && (
              <ul class="mt-1 space-y-0.5 text-[9.5px] text-zinc-600 leading-snug list-disc list-outside ml-3">
                {edu.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>
  )
}
