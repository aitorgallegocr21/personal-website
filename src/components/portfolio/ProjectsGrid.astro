---
import { cvData } from '@/data/cv-data';
import { Github, ExternalLink, ArrowUpRight } from 'lucide-astro';

const { projects } = cvData;
---

<section id="proyectos" class="py-12 sm:py-16 scroll-mt-20">
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 font-mono text-xs text-emerald-400 font-semibold tracking-wider uppercase mb-1">
      <span>// Proyectos destacados</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-100">
      Proyectos &amp; Software
    </h2>
    <p class="text-sm sm:text-base text-zinc-400 mt-1 max-w-xl">
      Sistemas, aplicaciones web y utilidades desarrolladas con foco en código limpio, arquitectura estructurada y rendimiento.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
    {
      projects.map((project) => (
        <article class="group relative flex flex-col justify-between rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-6 backdrop-blur-sm transition-all duration-300 hover:border-zinc-700 hover:bg-zinc-900/70 hover:shadow-2xl hover:shadow-zinc-950/50">
          <div>
            <div class="flex items-start justify-between gap-4 mb-3">
              <h3 class="text-lg font-semibold text-zinc-100 group-hover:text-white transition-colors">
                {project.title}
              </h3>
              {project.technologies[0] && (
                <span class="shrink-0 font-mono text-xs px-2 py-0.5 rounded-md bg-zinc-800/70 text-zinc-300 border border-zinc-700/50">
                  {project.technologies[0]}
                </span>
              )}
            </div>

            <p class="text-sm text-zinc-400 leading-relaxed mb-4">
              {project.summary}
            </p>

            {project.bullets && project.bullets.length > 0 && (
              <ul class="space-y-1.5 mb-5 text-xs text-zinc-400/90">
                {project.bullets.map((bullet) => (
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-400 select-none mt-0.5 leading-none font-bold">›</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>

          <div>
            <div class="flex flex-wrap gap-1.5 mb-5 pt-3 border-t border-zinc-800/60">
              {project.technologies.map((tech) => (
                <span class="font-mono text-[11px] px-2 py-0.5 rounded bg-zinc-800/40 text-zinc-400 border border-zinc-800">
                  {tech}
                </span>
              ))}
            </div>

            <div class="flex items-center gap-4 text-xs font-medium">
              {project.repoUrl && (
                <a
                  href={project.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/link inline-flex items-center gap-1.5 text-zinc-300 hover:text-white transition-colors"
                  aria-label={`Ver código de ${project.title}`}
                >
                  <Github class="w-3.5 h-3.5 text-zinc-400 group-hover/link:text-white transition-colors" />
                  <span>Repositorio</span>
                  <ArrowUpRight class="w-3.5 h-3.5 text-zinc-500 transition-transform duration-200 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 group-hover/link:text-zinc-300" />
                </a>
              )}

              {project.liveUrl && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/link inline-flex items-center gap-1.5 text-emerald-400 hover:text-emerald-300 transition-colors"
                  aria-label={`Ver demo en vivo de ${project.title}`}
                >
                  <ExternalLink class="w-3.5 h-3.5 text-emerald-400 group-hover/link:text-emerald-300 transition-colors" />
                  <span>Demo en vivo</span>
                  <ArrowUpRight class="w-3.5 h-3.5 text-emerald-500 transition-transform duration-200 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 group-hover/link:text-emerald-300" />
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
