---
import { cvData } from '@/data/cv-data';
import { X, Download, FileText, ExternalLink, Files } from 'lucide-astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Prepare deep-link registry for all certificates & degrees
const docRegistry: Record<
  string,
  {
    title: string;
    subtitle: string;
    url: string;
    docs?: Array<{ title: string; url: string; type?: string }>;
  }
> = {};

// 1. Technical Certificates
cvData.certificates.forEach((cert) => {
  const mainUrl = cert.documentUrl
    ? `${baseUrl}${cert.documentUrl}`
    : cert.documents?.[0]
      ? `${baseUrl}${cert.documents[0].url}`
      : '';
  const docs = cert.documents?.map((d) => ({
    title: d.title,
    url: `${baseUrl}${d.url}`,
    type: d.type,
  }));

  docRegistry[cert.id] = {
    title: cert.title,
    subtitle: `${cert.issuer} · ${cert.category}`,
    url: mainUrl,
    docs,
  };
});

// 2. Education (CFGM SMR Degree)
const smrEdu = cvData.education.find(
  (e) => e.degree.includes('SMR') || e.documentUrl
);
if (smrEdu && smrEdu.documentUrl) {
  docRegistry['gm-smr'] = {
    title: smrEdu.degree,
    subtitle: `${smrEdu.institution} · ${smrEdu.period}`,
    url: `${baseUrl}${smrEdu.documentUrl}`,
  };
}
---

<dialog
  id="certificate-modal"
  class="fixed inset-0 m-0 h-screen w-screen max-h-none max-w-none bg-transparent p-3 sm:p-6 md:p-10 backdrop:bg-zinc-950/80 backdrop:backdrop-blur-md z-50 items-center justify-center border-0"
  aria-labelledby="cert-modal-title"
  aria-modal="true"
>
  <div
    class="relative w-full max-w-5xl h-[90vh] max-h-[920px] flex flex-col rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-2xl overflow-hidden transition-all"
    id="cert-modal-container"
  >
    <!-- Modal Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between px-5 py-3.5 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50/80 dark:bg-zinc-900/90 backdrop-blur-sm shrink-0 gap-3">
      <div class="flex items-center gap-3 min-w-0">
        <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-[var(--color-accent-subtle)] text-[var(--color-accent)] border border-[var(--color-accent-border)] shrink-0">
          <FileText class="w-4 h-4" />
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <h2
              id="cert-modal-title"
              class="text-sm sm:text-base font-semibold text-zinc-900 dark:text-zinc-100 truncate"
            >
              Visor de Documento
            </h2>
            <span
              id="cert-modal-counter-badge"
              class="hidden font-mono text-[11px] px-2 py-0.5 rounded-md bg-[var(--color-accent-subtle)] text-[var(--color-accent)] border border-[var(--color-accent-border)] font-semibold shrink-0"
            >
              1 de 1
            </span>
          </div>
          <p
            id="cert-modal-subtitle"
            class="text-xs text-zinc-500 dark:text-zinc-400 font-mono truncate"
          >
            Acreditación oficial
          </p>
        </div>
      </div>

      <!-- Action buttons -->
      <div class="flex items-center gap-2 shrink-0 self-end sm:self-auto">
        <!-- Batch download all documents into a single ZIP (visible when multiple docs exist) -->
        <button
          id="cert-modal-download-all"
          type="button"
          class="hidden inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 border border-zinc-300 dark:border-zinc-700 hover:border-[var(--color-accent-border)] transition-all cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          title="Descargar todos los documentos en un archivo ZIP"
        >
          <Files class="w-3.5 h-3.5 text-[var(--color-accent)]" />
          <span id="cert-modal-download-all-text">Descargar todos (ZIP)</span>
        </button>

        <!-- Current Document Download -->
        <a
          id="cert-modal-download"
          href="#"
          download
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-[var(--color-accent)] text-[var(--color-accent-contrast)] hover:opacity-90 hover:scale-[1.02] active:scale-[0.98] transition-all shadow-xs"
          title="Descargar documento PDF actual"
        >
          <Download class="w-3.5 h-3.5" />
          <span class="hidden sm:inline">Descargar PDF</span>
        </a>

        <!-- Open External Tab -->
        <a
          id="cert-modal-external"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center p-1.5 sm:px-3 sm:py-1.5 rounded-lg text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 transition-colors"
          title="Abrir en pestaña nueva"
        >
          <ExternalLink class="w-4 h-4" />
          <span class="hidden sm:inline ml-1.5">Abrir</span>
        </a>

        <!-- Close Button -->
        <button
          id="cert-modal-close"
          type="button"
          class="p-1.5 rounded-lg text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
          aria-label="Cerrar visor"
        >
          <X class="w-5 h-5" />
        </button>
      </div>
    </div>

    <!-- Multi-document Switcher Bar (visible when multiple docs exist) -->
    <div
      id="cert-modal-nav-container"
      class="hidden px-5 py-2 bg-zinc-100/90 dark:bg-zinc-800/70 border-b border-zinc-200 dark:border-zinc-800/80 overflow-x-auto flex items-center gap-2 shrink-0 scrollbar-none"
    >
      <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 font-semibold uppercase tracking-wider shrink-0">
        Módulos:
      </span>
      <div
        id="cert-modal-nav-tabs"
        class="flex items-center gap-1.5 flex-nowrap"
      >
        <!-- Injected dynamically -->
      </div>
    </div>

    <!-- Viewer Body -->
    <div class="relative flex-1 bg-zinc-100 dark:bg-zinc-950 overflow-hidden flex items-center justify-center">
      <div
        id="cert-modal-loading"
        class="absolute inset-0 flex items-center justify-center text-xs font-mono text-zinc-500"
      >
        Cargando documento...
      </div>
      <iframe
        id="cert-modal-iframe"
        src="about:blank"
        class="w-full h-full border-0 relative z-10"
        title="Vista previa del documento"
      ></iframe>
    </div>
  </div>
</dialog>

<!-- Client Deep-Link Dictionary -->
<script
  id="doc-registry-data"
  type="application/json"
  set:html={JSON.stringify(docRegistry)}
/>
<style>
  dialog:not([open]) {
    display: none !important;
  }
  dialog[open] {
    display: flex !important;
  }
</style>

<script>
  import { initCertificateModal } from '@/lib/modal-manager';

  initCertificateModal();
  document.addEventListener('astro:after-swap', initCertificateModal);
</script>
