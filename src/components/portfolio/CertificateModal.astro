---
import { cvData } from '@/data/cv-data';
import { X, Download, FileText, ExternalLink, Files } from 'lucide-astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Prepare deep-link registry for all certificates & degrees
const docRegistry: Record<
  string,
  {
    title: string;
    subtitle: string;
    url: string;
    docs?: Array<{ title: string; url: string; type?: string }>;
  }
> = {};

// 1. Technical Certificates
cvData.certificates.forEach((cert) => {
  const mainUrl = cert.documentUrl
    ? `${baseUrl}${cert.documentUrl}`
    : cert.documents?.[0]
      ? `${baseUrl}${cert.documents[0].url}`
      : '';
  const docs = cert.documents?.map((d) => ({
    title: d.title,
    url: `${baseUrl}${d.url}`,
    type: d.type,
  }));

  docRegistry[cert.id] = {
    title: cert.title,
    subtitle: `${cert.issuer} · ${cert.category}`,
    url: mainUrl,
    docs,
  };
});

// 2. Education (CFGM SMR Degree)
const smrEdu = cvData.education.find(
  (e) => e.degree.includes('SMR') || e.documentUrl
);
if (smrEdu && smrEdu.documentUrl) {
  docRegistry['gm-smr'] = {
    title: smrEdu.degree,
    subtitle: `${smrEdu.institution} · ${smrEdu.period}`,
    url: `${baseUrl}${smrEdu.documentUrl}`,
  };
}
---

<dialog
  id="certificate-modal"
  class="fixed inset-0 m-0 h-screen w-screen max-h-none max-w-none bg-transparent p-0 sm:p-6 md:p-8 backdrop:bg-zinc-950/80 backdrop:backdrop-blur-md z-50 items-center justify-center border-0"
  aria-labelledby="cert-modal-title"
  aria-modal="true"
>
  <div
    class="relative w-full max-w-5xl h-[100dvh] sm:h-[90vh] sm:max-h-[920px] flex flex-col rounded-none sm:rounded-2xl border-0 sm:border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-2xl overflow-hidden transition-all"
    id="cert-modal-container"
  >
    <!-- Modal Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between px-3.5 sm:px-5 py-2.5 sm:py-3.5 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50/90 dark:bg-zinc-900/95 backdrop-blur-md shrink-0 gap-2.5 sm:gap-4">
      <!-- Title Area & Mobile Close Button -->
      <div class="flex items-center justify-between sm:justify-start gap-2.5 min-w-0">
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-[var(--color-accent-subtle)] text-[var(--color-accent)] border border-[var(--color-accent-border)] shrink-0">
            <FileText class="w-4 h-4" />
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-1.5 sm:gap-2">
              <h2
                id="cert-modal-title"
                class="text-sm sm:text-base font-semibold text-zinc-900 dark:text-zinc-100 truncate"
              >
                Visor de Documento
              </h2>
              <span
                id="cert-modal-counter-badge"
                class="hidden font-mono text-[10px] sm:text-[11px] px-1.5 py-0.5 rounded-md bg-[var(--color-accent-subtle)] text-[var(--color-accent)] border border-[var(--color-accent-border)] font-semibold shrink-0"
              >
                1 de 1
              </span>
            </div>
            <p
              id="cert-modal-subtitle"
              class="text-xs text-zinc-500 dark:text-zinc-400 font-mono truncate"
            >
              Acreditación oficial
            </p>
          </div>
        </div>

        <!-- Mobile Close Button (Touch Target >= 44x44px) -->
        <button
          type="button"
          class="cert-modal-close-trigger sm:hidden min-h-[44px] min-w-[44px] -mr-1 flex items-center justify-center rounded-xl text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white hover:bg-zinc-200/60 dark:hover:bg-zinc-800 transition-colors cursor-pointer shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
          aria-label="Cerrar visor de documento"
        >
          <X class="w-5 h-5" />
        </button>
      </div>

      <!-- Action Buttons Row -->
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0 justify-end w-full sm:w-auto">
        <!-- Batch download all documents into a single ZIP (visible when multiple docs exist) -->
        <button
          id="cert-modal-download-all"
          type="button"
          class="hidden inline-flex items-center justify-center gap-1.5 min-h-[38px] px-2.5 sm:px-3 py-1.5 rounded-lg text-xs font-semibold bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 border border-zinc-300 dark:border-zinc-700 hover:border-[var(--color-accent-border)] transition-all cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed flex-1 sm:flex-initial"
          title="Descargar todos los documentos en un archivo ZIP"
        >
          <Files class="w-3.5 h-3.5 text-[var(--color-accent)] shrink-0" />
          <span id="cert-modal-download-all-text">ZIP</span>
        </button>

        <!-- Current Document Download -->
        <a
          id="cert-modal-download"
          href="#"
          download
          class="inline-flex items-center justify-center gap-1.5 min-h-[38px] px-3 py-1.5 rounded-lg text-xs font-semibold bg-[var(--color-accent)] text-[var(--color-accent-contrast)] hover:opacity-90 active:scale-[0.98] transition-all shadow-xs flex-1 sm:flex-initial"
          title="Descargar documento PDF actual"
        >
          <Download class="w-3.5 h-3.5 shrink-0" />
          <span>
            <span class="inline sm:hidden">Descargar</span>
            <span class="hidden sm:inline">Descargar PDF</span>
          </span>
        </a>

        <!-- Open External Tab -->
        <a
          id="cert-modal-external"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center min-h-[38px] min-w-[38px] p-2 sm:px-3 sm:py-1.5 rounded-lg text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 transition-colors shrink-0"
          title="Abrir en pestaña nueva"
        >
          <ExternalLink class="w-4 h-4 shrink-0" />
          <span class="hidden sm:inline ml-1.5">Abrir</span>
        </a>

        <!-- Desktop Close Button -->
        <button
          type="button"
          id="cert-modal-close"
          class="cert-modal-close-trigger hidden sm:flex items-center justify-center p-2 rounded-lg text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
          aria-label="Cerrar visor de documento"
        >
          <X class="w-5 h-5" />
        </button>
      </div>
    </div>

    <!-- Multi-document Switcher Bar (visible when multiple docs exist) -->
    <div
      id="cert-modal-nav-container"
      class="hidden px-3.5 sm:px-5 py-2 bg-zinc-100/90 dark:bg-zinc-800/70 border-b border-zinc-200 dark:border-zinc-800/80 overflow-x-auto flex items-center gap-2 shrink-0 scrollbar-none"
    >
      <span class="text-[10px] sm:text-[11px] font-mono text-zinc-500 dark:text-zinc-400 font-semibold uppercase tracking-wider shrink-0">
        Módulos:
      </span>
      <div
        id="cert-modal-nav-tabs"
        class="flex items-center gap-1.5 flex-nowrap"
      >
        <!-- Injected dynamically -->
      </div>
    </div>

    <!-- Viewer Body -->
    <div class="relative flex-1 bg-zinc-100 dark:bg-zinc-950 overflow-hidden flex flex-col items-center justify-center">
      <!-- Mobile Helper Banner (iOS / Android iframe scrolling fallback) -->
      <div
        id="cert-modal-mobile-banner"
        class="sm:hidden w-full px-3.5 py-2 bg-zinc-900/95 dark:bg-zinc-950/95 text-white border-b border-zinc-800 flex items-center justify-between gap-2 shrink-0 z-20"
      >
        <div class="flex items-center gap-2 min-w-0">
          <span class="w-2 h-2 rounded-full bg-[var(--color-accent)] shrink-0 animate-pulse"></span>
          <span class="text-[11px] text-zinc-300 truncate">
            Vista móvil · ¿Deseas ver a pantalla completa?
          </span>
        </div>
        <a
          id="cert-modal-mobile-open"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[11px] font-semibold bg-[var(--color-accent)] text-[var(--color-accent-contrast)] hover:opacity-90 transition-opacity shrink-0 shadow-xs"
        >
          <ExternalLink class="w-3 h-3 shrink-0" />
          <span>Ver PDF</span>
        </a>
      </div>

      <!-- Loading State -->
      <div
        id="cert-modal-loading"
        class="absolute inset-0 flex items-center justify-center text-xs font-mono text-zinc-500 z-0"
      >
        Cargando documento...
      </div>

      <!-- PDF Preview Iframe -->
      <iframe
        id="cert-modal-iframe"
        src="about:blank"
        class="w-full flex-1 border-0 relative z-10"
        title="Vista previa del documento"
      ></iframe>
    </div>
  </div>
</dialog>

<!-- Client Deep-Link Dictionary -->
<script
  id="doc-registry-data"
  type="application/json"
  set:html={JSON.stringify(docRegistry)}
/>
<style>
  dialog:not([open]) {
    display: none !important;
  }
  dialog[open] {
    display: flex !important;
  }
</style>

<script>
  import { initCertificateModal } from '@/lib/modal-manager';

  initCertificateModal();
  document.addEventListener('astro:after-swap', initCertificateModal);
</script>
