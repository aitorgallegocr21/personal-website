---
import { cvData } from '@/data/cv-data';
import { X, Download, FileText, ExternalLink, Files } from 'lucide-astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Prepare deep-link registry for all certificates & degrees
const docRegistry: Record<
  string,
  {
    title: string;
    subtitle: string;
    url: string;
    docs?: Array<{ title: string; url: string; type?: string }>;
  }
> = {};

// 1. Technical Certificates
cvData.certificates.forEach((cert) => {
  const mainUrl = cert.documentUrl
    ? `${baseUrl}${cert.documentUrl}`
    : cert.documents?.[0]
      ? `${baseUrl}${cert.documents[0].url}`
      : '';
  const docs = cert.documents?.map((d) => ({
    title: d.title,
    url: `${baseUrl}${d.url}`,
    type: d.type,
  }));

  docRegistry[cert.id] = {
    title: cert.title,
    subtitle: `${cert.issuer} · ${cert.category}`,
    url: mainUrl,
    docs,
  };
});

// 2. Education (CFGM SMR Degree)
const smrEdu = cvData.education.find((e) => e.degree.includes('SMR') || e.documentUrl);
if (smrEdu && smrEdu.documentUrl) {
  docRegistry['gm-smr'] = {
    title: smrEdu.degree,
    subtitle: `${smrEdu.institution} · ${smrEdu.period}`,
    url: `${baseUrl}${smrEdu.documentUrl}`,
  };
}
---

<dialog
  id="certificate-modal"
  class="fixed inset-0 m-0 h-screen w-screen max-h-none max-w-none bg-transparent p-3 sm:p-6 md:p-10 backdrop:bg-zinc-950/80 backdrop:backdrop-blur-md z-50 items-center justify-center border-0"
  aria-labelledby="cert-modal-title"
  aria-modal="true"
>
  <div
    class="relative w-full max-w-5xl h-[90vh] max-h-[920px] flex flex-col rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-2xl overflow-hidden transition-all"
    id="cert-modal-container"
  >
    <!-- Modal Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between px-5 py-3.5 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50/80 dark:bg-zinc-900/90 backdrop-blur-sm shrink-0 gap-3">
      <div class="flex items-center gap-3 min-w-0">
        <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-[var(--color-accent-subtle)] text-[var(--color-accent)] border border-[var(--color-accent-border)] shrink-0">
          <FileText class="w-4 h-4" />
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <h2 id="cert-modal-title" class="text-sm sm:text-base font-semibold text-zinc-900 dark:text-zinc-100 truncate">
              Visor de Documento
            </h2>
            <span
              id="cert-modal-counter-badge"
              class="hidden font-mono text-[11px] px-2 py-0.5 rounded-md bg-[var(--color-accent-subtle)] text-[var(--color-accent)] border border-[var(--color-accent-border)] font-semibold shrink-0"
            >
              1 de 1
            </span>
          </div>
          <p id="cert-modal-subtitle" class="text-xs text-zinc-500 dark:text-zinc-400 font-mono truncate">
            Acreditación oficial
          </p>
        </div>
      </div>

      <!-- Action buttons -->
      <div class="flex items-center gap-2 shrink-0 self-end sm:self-auto">
        <!-- Batch download all documents into a single ZIP (visible when multiple docs exist) -->
        <button
          id="cert-modal-download-all"
          type="button"
          class="hidden inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 border border-zinc-300 dark:border-zinc-700 hover:border-[var(--color-accent-border)] transition-all cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          title="Descargar todos los documentos en un archivo ZIP"
        >
          <Files class="w-3.5 h-3.5 text-[var(--color-accent)]" />
          <span id="cert-modal-download-all-text">Descargar todos (ZIP)</span>
        </button>

        <!-- Current Document Download -->
        <a
          id="cert-modal-download"
          href="#"
          download
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-[var(--color-accent)] text-[var(--color-accent-contrast)] hover:opacity-90 hover:scale-[1.02] active:scale-[0.98] transition-all shadow-xs"
          title="Descargar documento PDF actual"
        >
          <Download class="w-3.5 h-3.5" />
          <span class="hidden sm:inline">Descargar PDF</span>
        </a>

        <!-- Open External Tab -->
        <a
          id="cert-modal-external"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center p-1.5 sm:px-3 sm:py-1.5 rounded-lg text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 transition-colors"
          title="Abrir en pestaña nueva"
        >
          <ExternalLink class="w-4 h-4" />
          <span class="hidden sm:inline ml-1.5">Abrir</span>
        </a>

        <!-- Close Button -->
        <button
          id="cert-modal-close"
          type="button"
          class="p-1.5 rounded-lg text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
          aria-label="Cerrar visor"
        >
          <X class="w-5 h-5" />
        </button>
      </div>
    </div>

    <!-- Multi-document Switcher Bar (visible when multiple docs exist) -->
    <div
      id="cert-modal-nav-container"
      class="hidden px-5 py-2 bg-zinc-100/90 dark:bg-zinc-800/70 border-b border-zinc-200 dark:border-zinc-800/80 overflow-x-auto flex items-center gap-2 shrink-0 scrollbar-none"
    >
      <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 font-semibold uppercase tracking-wider shrink-0">
        Módulos:
      </span>
      <div id="cert-modal-nav-tabs" class="flex items-center gap-1.5 flex-nowrap">
        <!-- Injected dynamically -->
      </div>
    </div>

    <!-- Viewer Body -->
    <div class="relative flex-1 bg-zinc-100 dark:bg-zinc-950 overflow-hidden flex items-center justify-center">
      <div id="cert-modal-loading" class="absolute inset-0 flex items-center justify-center text-xs font-mono text-zinc-500">
        Cargando documento...
      </div>
      <iframe
        id="cert-modal-iframe"
        src="about:blank"
        class="w-full h-full border-0 relative z-10"
        title="Vista previa del documento"
      ></iframe>
    </div>
  </div>
</dialog>

<!-- Client Deep-Link Dictionary -->
<script id="doc-registry-data" type="application/json" set:html={JSON.stringify(docRegistry)} />

<style>
  dialog:not([open]) {
    display: none !important;
  }
  dialog[open] {
    display: flex !important;
  }
</style>

<script>
  import JSZip from 'jszip';

  interface DocItem {
    title: string;
    url: string;
    type?: string;
  }

  const modal = document.getElementById('certificate-modal') as HTMLDialogElement | null;
  const modalContainer = document.getElementById('cert-modal-container');
  const modalTitle = document.getElementById('cert-modal-title');
  const modalSubtitle = document.getElementById('cert-modal-subtitle');
  const modalCounterBadge = document.getElementById('cert-modal-counter-badge');
  const modalDownload = document.getElementById('cert-modal-download') as HTMLAnchorElement | null;
  const modalDownloadAll = document.getElementById('cert-modal-download-all') as HTMLButtonElement | null;
  const modalDownloadAllText = document.getElementById('cert-modal-download-all-text');
  const modalExternal = document.getElementById('cert-modal-external') as HTMLAnchorElement | null;
  const modalIframe = document.getElementById('cert-modal-iframe') as HTMLIFrameElement | null;
  const modalLoading = document.getElementById('cert-modal-loading');
  const modalClose = document.getElementById('cert-modal-close');
  const modalNavContainer = document.getElementById('cert-modal-nav-container');
  const modalNavTabs = document.getElementById('cert-modal-nav-tabs');

  let currentDocsList: DocItem[] = [];

  function selectDoc(index: number) {
    if (!currentDocsList[index] || !modalIframe || !modalDownload) return;
    const doc = currentDocsList[index];

    if (modalLoading) modalLoading.classList.remove('hidden');
    modalIframe.src = doc.url;
    modalDownload.href = doc.url;
    modalDownload.download = doc.url.split('/').pop() || `${doc.title}.pdf`;

    if (modalExternal) {
      modalExternal.href = doc.url;
    }

    if (modalCounterBadge) {
      modalCounterBadge.textContent = `${index + 1} de ${currentDocsList.length}`;
    }

    // Update active tab styles
    if (modalNavTabs) {
      const tabButtons = modalNavTabs.querySelectorAll<HTMLButtonElement>('.doc-tab-btn');
      tabButtons.forEach((btn, i) => {
        if (i === index) {
          btn.className = 'doc-tab-btn shrink-0 px-2.5 py-1 rounded-md text-xs font-semibold bg-[var(--color-accent)] text-[var(--color-accent-contrast)] border border-[var(--color-accent)] shadow-xs transition-all cursor-default';
        } else {
          btn.className = 'doc-tab-btn shrink-0 px-2.5 py-1 rounded-md text-xs font-medium bg-white dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 border border-zinc-200 dark:border-zinc-700/60 hover:border-[var(--color-accent-border)] transition-all cursor-pointer';
        }
      });
    }
  }

  function openCertificateModal(url: string, title: string, subtitle?: string, docsJson?: string) {
    if (!modal || !modalIframe || !modalDownload) return;

    if (modalTitle) modalTitle.textContent = title;
    if (modalSubtitle) modalSubtitle.textContent = subtitle || 'Acreditación oficial';

    // Parse docs array if provided
    let parsedDocs: DocItem[] = [];
    if (docsJson) {
      try {
        parsedDocs = JSON.parse(docsJson);
      } catch (e) {
        console.error('Failed to parse data-docs JSON:', e);
      }
    }

    if (parsedDocs.length > 0) {
      currentDocsList = parsedDocs;
    } else if (url) {
      currentDocsList = [{ title, url, type: 'main' }];
    } else {
      currentDocsList = [];
    }

    // Configure multi-document vs single-document view
    if (currentDocsList.length > 1) {
      if (modalNavContainer) modalNavContainer.classList.remove('hidden');
      if (modalDownloadAll) {
        modalDownloadAll.classList.remove('hidden');
        modalDownloadAll.title = 'Descargar todos los documentos en un archivo ZIP';
      }
      if (modalDownloadAllText) modalDownloadAllText.textContent = `Descargar ZIP (${currentDocsList.length})`;
      if (modalCounterBadge) modalCounterBadge.classList.remove('hidden');

      // Populate tabs
      if (modalNavTabs) {
        modalNavTabs.innerHTML = '';
        currentDocsList.forEach((doc, i) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = doc.title;
          btn.className = 'doc-tab-btn shrink-0 px-2.5 py-1 rounded-md text-xs transition-all';
          btn.addEventListener('click', () => selectDoc(i));
          modalNavTabs.appendChild(btn);
        });
      }

      // Check if requested url matches any specific document
      const targetIndex = Math.max(0, currentDocsList.findIndex((d) => d.url === url));
      selectDoc(targetIndex);
    } else {
      if (modalNavContainer) modalNavContainer.classList.add('hidden');
      if (modalDownloadAll) modalDownloadAll.classList.add('hidden');
      if (modalCounterBadge) modalCounterBadge.classList.add('hidden');

      const singleUrl = currentDocsList[0]?.url || url;
      if (modalLoading) modalLoading.classList.remove('hidden');
      modalIframe.src = singleUrl;
      modalDownload.href = singleUrl;
      modalDownload.download = singleUrl.split('/').pop() || 'documento.pdf';
      if (modalExternal) {
        modalExternal.href = singleUrl;
      }
    }

    modal.showModal();
    document.body.classList.add('overflow-hidden');
  }

  function closeCertificateModal() {
    if (!modal) return;
    if (modal.open) {
      modal.close();
    }
    if (modalIframe) modalIframe.src = 'about:blank';
    if (modalDownload) {
      modalDownload.href = '#';
      modalDownload.removeAttribute('download');
    }
    if (modalExternal) {
      modalExternal.href = '#';
    }
    if (modalLoading) modalLoading.classList.remove('hidden');
    if (modalNavContainer) modalNavContainer.classList.add('hidden');
    if (modalDownloadAll) modalDownloadAll.classList.add('hidden');
    currentDocsList = [];
    document.body.classList.remove('overflow-hidden');

    // Clean up query parameters from URL if present
    try {
      const url = new URL(window.location.href);
      if (url.searchParams.has('doc') || url.searchParams.has('cert')) {
        url.searchParams.delete('doc');
        url.searchParams.delete('cert');
        window.history.replaceState({}, '', url.pathname + url.search + url.hash);
      }
    } catch {
      // ignore
    }
  }

  modalClose?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeCertificateModal();
  });

  // Batch download all documents compressed into a single ZIP archive
  modalDownloadAll?.addEventListener('click', async () => {
    if (currentDocsList.length === 0) return;
    const originalText = modalDownloadAllText?.textContent || 'Descargar ZIP';
    if (modalDownloadAllText) modalDownloadAllText.textContent = 'Generando ZIP...';
    modalDownloadAll.disabled = true;

    try {
      const zip = new JSZip();
      const currentTitle = modalTitle?.textContent?.trim() || 'Certificados';
      const cleanFileName = `Certificados_${currentTitle.replace(/[^a-zA-Z0-9_\u00C0-\u017F-]/g, '_')}.zip`;

      // Fetch all PDFs asynchronously
      const fetchPromises = currentDocsList.map(async (doc) => {
        const response = await fetch(doc.url);
        if (!response.ok) {
          throw new Error(`Error descargando documento: ${doc.url} (${response.statusText})`);
        }
        const blob = await response.blob();
        let fileName = doc.url.split('/').pop() || `${doc.title}.pdf`;
        try {
          fileName = decodeURIComponent(fileName);
        } catch {
          // ignore
        }
        if (!fileName.toLowerCase().endsWith('.pdf')) {
          fileName += '.pdf';
        }
        zip.file(fileName, blob);
      });

      await Promise.all(fetchPromises);

      // Generate compressed zip archive
      const zipBlob = await zip.generateAsync({
        type: 'blob',
        compression: 'DEFLATE',
        compressionOptions: { level: 6 },
      });

      // Trigger single download prompt
      const downloadUrl = URL.createObjectURL(zipBlob);
      const a = document.createElement('a');
      a.href = downloadUrl;
      a.download = cleanFileName;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(downloadUrl);

      if (modalDownloadAllText) {
        modalDownloadAllText.textContent = '¡ZIP Descargado!';
      }
    } catch (err) {
      console.error('Error al empaquetar archivo ZIP:', err);
      if (modalDownloadAllText) {
        modalDownloadAllText.textContent = 'Error al generar';
      }
    } finally {
      setTimeout(() => {
        if (modalDownloadAllText) modalDownloadAllText.textContent = originalText;
        if (modalDownloadAll) modalDownloadAll.disabled = false;
      }, 2500);
    }
  });

  // Close when clicking dialog backdrop outside modalContainer
  modal?.addEventListener('click', (e) => {
    if (!modalContainer) return;
    const rect = modalContainer.getBoundingClientRect();
    const isInDialog = (
      rect.top <= e.clientY &&
      e.clientY <= rect.top + rect.height &&
      rect.left <= e.clientX &&
      e.clientX <= rect.left + rect.width
    );
    if (!isInDialog) {
      closeCertificateModal();
    }
  });

  // Handle escape key closing (cancel event triggered natively on dialog)
  modal?.addEventListener('cancel', () => {
    closeCertificateModal();
  });

  modalIframe?.addEventListener('load', () => {
    if (modalLoading && modalIframe.src && !modalIframe.src.endsWith('about:blank')) {
      modalLoading.classList.add('hidden');
    }
  });

  // Prevent invalid navigation if links clicked when not configured
  modalDownload?.addEventListener('click', (e) => {
    const href = modalDownload.getAttribute('href');
    if (!href || href === '#' || href === 'about:blank') {
      e.preventDefault();
    }
  });

  modalExternal?.addEventListener('click', (e) => {
    const href = modalExternal.getAttribute('href');
    if (!href || href === '#' || href === 'about:blank') {
      e.preventDefault();
    }
  });

  // Attach event delegation for any document trigger button across the page
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('[data-doc-url], [data-docs]') as HTMLElement | null;
    if (!target) return;

    e.preventDefault();
    const url = target.getAttribute('data-doc-url') || '';
    const title = target.getAttribute('data-doc-title') || 'Documento';
    const subtitle = target.getAttribute('data-doc-subtitle') || '';
    const docs = target.getAttribute('data-docs') || undefined;

    if (url || docs) {
      openCertificateModal(url, title, subtitle, docs);
    }
  });

  // Deep-link auto opener from URL params (?doc=<id> or ?cert=<id>)
  function checkUrlDeepLink() {
    try {
      const docRegistryEl = document.getElementById('doc-registry-data');
      if (!docRegistryEl || !docRegistryEl.textContent) return;
      const registry = JSON.parse(docRegistryEl.textContent);

      const params = new URLSearchParams(window.location.search);
      const targetId = params.get('doc') || params.get('cert');
      if (targetId && registry[targetId]) {
        const item = registry[targetId];
        openCertificateModal(
          item.url,
          item.title,
          item.subtitle,
          item.docs ? JSON.stringify(item.docs) : undefined
        );
      }
    } catch (e) {
      console.error('Error processing modal deep link:', e);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkUrlDeepLink);
  } else {
    checkUrlDeepLink();
  }
</script>
