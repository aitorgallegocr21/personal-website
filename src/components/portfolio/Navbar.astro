---
import { cvData } from '@/data/cv-data';
import {
  FileDown,
  Menu,
  X,
  GripVertical,
  PanelTop,
  PanelBottom,
  PanelLeft,
  PanelRight,
  RotateCcw,
  SlidersHorizontal,
  FolderGit2,
  Briefcase,
  Award,
  Sparkles,
  Mail,
} from 'lucide-astro';
import ThemeToggle from '@/components/portfolio/ThemeToggle.astro';

const { personal } = cvData;

const navItems = [
  { label: 'Proyectos', href: '#proyectos', number: '01', icon: FolderGit2 },
  { label: 'Trayectoria', href: '#trayectoria', number: '02', icon: Briefcase },
  {
    label: 'Certificaciones',
    href: '#certificaciones',
    number: '03',
    icon: Award,
  },
  { label: 'Filosofía', href: '#filosofia', number: '04', icon: Sparkles },
  { label: 'Contacto', href: '#contacto', number: '05', icon: Mail },
];
---

<header
  id="site-header"
  data-dock="top"
  data-hero-active="true"
  class="sticky top-3 sm:top-4 z-50 w-[calc(100%-1.5rem)] sm:w-[calc(100%-2rem)] max-w-5xl mx-auto rounded-full border border-zinc-200/80 dark:border-zinc-800/80 bg-white/85 dark:bg-zinc-950/85 backdrop-blur-md shadow-lg shadow-zinc-950/5 dark:shadow-zinc-950/30 hover:border-zinc-300 dark:hover:border-zinc-700/80 hover:shadow-[0_4px_24px_-4px_var(--color-accent-glow)] transition-all duration-300"
>
  <div
    id="site-header-inner"
    class="px-3.5 sm:px-6 h-14 sm:h-16 flex items-center justify-between gap-2 sm:gap-4 transition-all duration-300"
  >
    <!-- Left Cluster: Tactile Drag Grip & Brand Logo -->
    <div class="brand-cluster flex items-center gap-1 sm:gap-2 shrink-0">
      <!-- Desktop Drag Grip Handle -->
      <div
        id="dock-drag-handle"
        class="hidden lg:flex items-center justify-center w-6 h-8 rounded-lg text-zinc-400 dark:text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 cursor-grab active:cursor-grabbing hover:bg-zinc-100 dark:hover:bg-zinc-800/60 transition-colors touch-none select-none -ml-2"
        role="button"
        tabindex="0"
        aria-label="Arrastrar dock (Doble clic para restaurar arriba)"
        title="Arrastrar dock a cualquier borde (Doble clic para restaurar)"
      >
        <GripVertical class="w-4 h-4" />
      </div>

      <!-- Brand / Logo -->
      <a
        href={import.meta.env.BASE_URL}
        class="brand-logo group flex items-center gap-2.5 font-semibold text-zinc-900 dark:text-zinc-100 hover:text-zinc-950 dark:hover:text-white transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded-full py-1 px-2.5 -ml-1 shrink-0"
        aria-label={`Inicio - Portfolio de ${personal.name}`}
      >
        <span class="brand-beacon relative flex h-2.5 w-2.5 items-center justify-center">
          <span class="beacon-pulse absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-accent)] opacity-40 duration-1000"></span>
          <span class="beacon-dot relative inline-flex h-2.5 w-2.5 rounded-full bg-[var(--color-accent)] shadow-[0_0_8px_var(--color-accent-glow)] transition-all duration-300"></span>
        </span>
        <span class="brand-text text-sm sm:text-base font-bold tracking-tight group-hover:text-[var(--color-accent)] transition-all duration-300">
          Portfolio
        </span>
      </a>
    </div>

    <!-- Desktop Navigation Links -->
    <nav
      id="desktop-nav"
      class="hidden md:flex relative items-center gap-1 lg:gap-1.5 text-xs lg:text-sm font-medium text-zinc-600 dark:text-zinc-400 transition-all duration-300"
      aria-label="Navegación principal"
    >
      <!-- Fluid Scroll-Spy Animated Accent Pill -->
      <div
        id="navbar-fluid-indicator"
        class="pointer-events-none absolute left-0 top-0 rounded-xl opacity-0 z-0 bg-[var(--color-accent-subtle)] border border-[var(--color-accent-border)] shadow-[0_0_14px_var(--color-accent-glow)] transition-opacity duration-200"
        aria-hidden="true"
      >
        <span class="indicator-bar absolute bottom-0.5 left-1/2 -translate-x-1/2 w-3.5 h-0.5 bg-[var(--color-accent)] rounded-full shadow-[0_0_8px_var(--color-accent)] transition-all duration-300"></span>
      </div>

      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link group relative z-10 flex flex-col items-center justify-center px-2.5 py-1 min-w-[50px] rounded-xl text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100/50 dark:hover:bg-zinc-900/50 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
        >
          <item.icon class="nav-icon w-4 h-4 shrink-0 transition-transform duration-150 group-hover:scale-110" />
          <span class="nav-link-text text-[9.5px] font-semibold tracking-wider uppercase transition-colors duration-150 leading-tight select-none mt-0.5">
            {item.label}
          </span>
          <span
            class="nav-tooltip pointer-events-none absolute py-1 px-2.5 rounded-lg text-xs font-semibold whitespace-nowrap bg-zinc-900/95 dark:bg-zinc-800/95 text-white backdrop-blur-md shadow-lg border border-zinc-700/60 opacity-0 transition-all duration-150 scale-95 z-50"
            role="tooltip"
          >
            {item.label}
          </span>
        </a>
      ))}
    </nav>

    <!-- Action Controls: CV PDF, Theme Picker, Quick Dock & Mobile Menu Toggle -->
    <div class="header-actions flex items-center gap-1.5 sm:gap-2 shrink-0">
      <!-- CV PDF Link -->
      <a
        href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/cv`}
        class="cv-btn group relative inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-[var(--color-accent-subtle)] text-[var(--color-accent)] border border-[var(--color-accent-border)] hover:bg-[var(--color-accent)] hover:text-white hover:border-transparent transition-all duration-200 shadow-xs hover:shadow-[0_0_12px_var(--color-accent-glow)] active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
        aria-label="Ver y descargar currículum en PDF"
        title="Ver y descargar CV (PDF A4)"
      >
        <FileDown class="w-3.5 h-3.5 transition-transform duration-200 group-hover:-translate-y-0.5" />
        <span class="cv-text hidden sm:inline">CV PDF</span>
        <span class="cv-mobile-text sm:hidden font-mono text-[11px]">CV</span>
        <span
          class="nav-tooltip pointer-events-none absolute py-1 px-2.5 rounded-lg text-xs font-semibold whitespace-nowrap bg-zinc-900/95 dark:bg-zinc-800/95 text-white backdrop-blur-md shadow-lg border border-zinc-700/60 opacity-0 transition-all duration-150 scale-95 z-50"
          role="tooltip"
        >
          CV PDF
        </span>
      </a>

      <!-- Theme & Accent Controls -->
      <ThemeToggle />

      <!-- Quick Dock Trigger & Popover -->
      <div class="relative group hidden lg:block">
        <button
          type="button"
          id="dock-menu-btn"
          class="inline-flex items-center justify-center w-8 h-8 rounded-full text-zinc-500 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] cursor-pointer"
          aria-expanded="false"
          aria-controls="dock-menu-popover"
          aria-label="Opciones de anclaje del dock"
          title="Cambiar posición del dock"
        >
          <SlidersHorizontal class="w-3.5 h-3.5" />
        </button>
        <span
          class="nav-tooltip pointer-events-none absolute py-1 px-2.5 rounded-lg text-xs font-semibold whitespace-nowrap bg-zinc-900/95 dark:bg-zinc-800/95 text-white backdrop-blur-md shadow-lg border border-zinc-700/60 opacity-0 transition-all duration-150 scale-95 z-50"
          role="tooltip"
        >
          Posición del dock
        </span>

        <!-- Popover -->
        <div
          id="dock-menu-popover"
          class="hidden absolute z-50 p-2 rounded-2xl bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md border border-zinc-200/90 dark:border-zinc-800/90 shadow-2xl shadow-zinc-950/20 min-w-[170px] text-xs font-medium space-y-0.5"
          role="dialog"
          aria-label="Posición de anclaje del dock"
        >
          <div class="px-2.5 py-1 text-[11px] font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500 border-b border-zinc-100 dark:border-zinc-800/60 mb-1">
            Posición del dock
          </div>
          <button
            type="button"
            data-dock-target="top"
            class="dock-option-btn w-full flex items-center gap-2 px-2.5 py-1.5 rounded-xl text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-colors cursor-pointer text-left"
          >
            <PanelTop class="w-3.5 h-3.5 text-[var(--color-accent)]" />
            <span>Arriba (Top)</span>
          </button>
          <button
            type="button"
            data-dock-target="bottom"
            class="dock-option-btn w-full flex items-center gap-2 px-2.5 py-1.5 rounded-xl text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-colors cursor-pointer text-left"
          >
            <PanelBottom class="w-3.5 h-3.5 text-[var(--color-accent)]" />
            <span>Abajo (Bottom)</span>
          </button>
          <button
            type="button"
            data-dock-target="left"
            class="dock-option-btn w-full flex items-center gap-2 px-2.5 py-1.5 rounded-xl text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-colors cursor-pointer text-left"
          >
            <PanelLeft class="w-3.5 h-3.5 text-[var(--color-accent)]" />
            <span>Izquierda (Left)</span>
          </button>
          <button
            type="button"
            data-dock-target="right"
            class="dock-option-btn w-full flex items-center gap-2 px-2.5 py-1.5 rounded-xl text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-colors cursor-pointer text-left"
          >
            <PanelRight class="w-3.5 h-3.5 text-[var(--color-accent)]" />
            <span>Derecha (Right)</span>
          </button>
          <div class="border-t border-zinc-100 dark:border-zinc-800/60 pt-1 mt-1">
            <button
              type="button"
              data-dock-target="top"
              class="dock-option-btn w-full flex items-center gap-2 px-2.5 py-1.5 rounded-xl text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-colors cursor-pointer text-left font-mono text-[11px]"
            >
              <RotateCcw class="w-3.5 h-3.5" />
              <span>Restaurar posición</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="mobile-nav-toggle"
        class="md:hidden relative inline-flex items-center justify-center min-h-[44px] min-w-[44px] rounded-full text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800/70 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] cursor-pointer"
        aria-expanded="false"
        aria-controls="mobile-nav-menu"
        aria-label="Abrir menú de navegación"
      >
        <Menu class="w-5 h-5 menu-open-icon transition-transform duration-200" />
        <X class="w-5 h-5 menu-close-icon hidden transition-transform duration-200" />
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Dropdown (Overlay) -->
  <div
    id="mobile-nav-menu"
    class="hidden md:hidden absolute top-[calc(100%+0.5rem)] inset-x-0 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/95 dark:bg-zinc-950/95 backdrop-blur-xl shadow-2xl shadow-zinc-950/15 dark:shadow-black/60 p-3 space-y-1 z-50"
    role="region"
    aria-label="Menú de navegación para dispositivos móviles"
  >
    {navItems.map((item) => (
      <a
        href={item.href}
        class="mobile-nav-link group flex items-center justify-between min-h-[44px] px-3.5 py-2 rounded-xl text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-900/80 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
      >
        <div class="flex items-center gap-2.5">
          <item.icon class="w-4 h-4 text-zinc-400 group-hover:text-[var(--color-accent)] transition-colors" />
          <span class="group-hover:translate-x-1 transition-transform duration-150">
            {item.label}
          </span>
        </div>
        <span class="text-xs text-zinc-400 dark:text-zinc-500 font-mono group-hover:text-[var(--color-accent)] transition-colors">
          {item.number}
        </span>
      </a>
    ))}

    <!-- Mobile CV Action Card -->
    <div class="pt-2 mt-1.5 border-t border-zinc-200/60 dark:border-zinc-800/60">
      <a
        href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/cv`}
        class="mobile-nav-link flex items-center justify-center gap-2 min-h-[44px] px-4 py-2.5 rounded-xl text-xs font-semibold bg-[var(--color-accent-subtle)] text-[var(--color-accent)] border border-[var(--color-accent-border)] hover:bg-[var(--color-accent)] hover:text-white transition-all shadow-xs active:scale-98"
      >
        <FileDown class="w-4 h-4" />
        <span>Ver y Descargar CV (PDF A4)</span>
      </a>
    </div>
  </div>
</header>

<script>
  function getOrCreateMobileBackdrop(onClose?: () => void): HTMLElement {
    let backdrop = document.getElementById('mobile-nav-backdrop');
    if (!backdrop) {
      backdrop = document.createElement('div');
      backdrop.id = 'mobile-nav-backdrop';
      if (onClose) {
        backdrop.addEventListener('click', onClose);
      }
      document.body.appendChild(backdrop);
    } else if (backdrop.parentElement !== document.body) {
      document.body.appendChild(backdrop);
    }
    backdrop.className =
      'fixed inset-0 z-40 hidden bg-black/25 dark:bg-black/40 backdrop-blur-sm transition-opacity duration-200';
    backdrop.setAttribute('aria-hidden', 'true');
    return backdrop;
  }

  function setupMobileNav() {
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const navMenu = document.getElementById('mobile-nav-menu');
    const header = document.getElementById('site-header');

    if (!toggleBtn || !navMenu || !header) return;
    if (toggleBtn.dataset.bound === 'true') return;
    toggleBtn.dataset.bound = 'true';

    const openIcon = toggleBtn.querySelector('.menu-open-icon');
    const closeIcon = toggleBtn.querySelector('.menu-close-icon');
    const navLinks = navMenu.querySelectorAll('.mobile-nav-link');
    let mobileCloseTimeout: number | null = null;

    const closeMenu = () => {
      if (
        navMenu.classList.contains('hidden') &&
        navMenu.getAttribute('data-state') !== 'open'
      ) {
        return;
      }

      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.setAttribute('aria-label', 'Abrir menú de navegación');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');

      navMenu.setAttribute('data-state', 'closed');
      const backdrop = document.getElementById('mobile-nav-backdrop');
      backdrop?.setAttribute('data-state', 'closed');

      if (mobileCloseTimeout) clearTimeout(mobileCloseTimeout);
      mobileCloseTimeout = window.setTimeout(() => {
        navMenu.classList.add('hidden');
        navMenu.removeAttribute('data-state');
        backdrop?.classList.add('hidden');
        backdrop?.removeAttribute('data-state');
        mobileCloseTimeout = null;
      }, 120);
    };

    const openMenu = () => {
      if (mobileCloseTimeout) {
        clearTimeout(mobileCloseTimeout);
        mobileCloseTimeout = null;
      }

      const backdrop = getOrCreateMobileBackdrop(closeMenu);
      backdrop.classList.remove('hidden');
      void backdrop.offsetWidth;
      backdrop.setAttribute('data-state', 'open');

      navMenu.classList.remove('hidden');
      void navMenu.offsetWidth;
      navMenu.setAttribute('data-state', 'open');

      toggleBtn.setAttribute('aria-expanded', 'true');
      toggleBtn.setAttribute('aria-label', 'Cerrar menú de navegación');
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');

      // Close theme palette popover if open to prevent overlaps
      const paletteDropdown = document.getElementById('palette-dropdown');
      const paletteBackdrop = document.getElementById('palette-backdrop');
      const paletteBtn = document.getElementById('palette-menu-btn');
      if (paletteDropdown && !paletteDropdown.classList.contains('hidden')) {
        paletteDropdown.classList.add('hidden');
        paletteBackdrop?.classList.add('hidden');
        paletteBtn?.setAttribute('aria-expanded', 'false');
      }
    };

    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close on navigation link tap
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Close on click outside header
    document.addEventListener('click', (e) => {
      const target = e.target as Node | null;
      if (target && !header.contains(target)) {
        if (toggleBtn.getAttribute('aria-expanded') === 'true') {
          closeMenu();
        }
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (
        e.key === 'Escape' &&
        toggleBtn.getAttribute('aria-expanded') === 'true'
      ) {
        closeMenu();
        toggleBtn.focus();
      }
    });

    // Close on resize to tablet/desktop
    const mediaQuery = window.matchMedia('(min-width: 768px)');
    mediaQuery.addEventListener('change', (e) => {
      if (e.matches && toggleBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });

    // Mutual close when palette button is clicked
    const paletteBtn = document.getElementById('palette-menu-btn');
    paletteBtn?.addEventListener('click', () => {
      if (toggleBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });

    const syncMobileHero = () => {
      if (window.scrollY < 120) {
        header.setAttribute('data-hero-active', 'true');
      } else {
        header.removeAttribute('data-hero-active');
      }
    };
    window.addEventListener('scroll', syncMobileHero, { passive: true });
    syncMobileHero();
  }

  setupMobileNav();
  document.addEventListener('astro:after-swap', setupMobileNav);

  import {
    initFluidScrollSpy,
    type FluidScrollSpyController,
  } from '@/lib/scroll-spy';
  import {
    initDockManager,
    type DockManagerController,
  } from '@/lib/dock-manager';

  let scrollSpyController: FluidScrollSpyController | null = null;
  let dockController: DockManagerController | null = null;

  function setupDesktopScrollSpy() {
    scrollSpyController?.destroy();
    scrollSpyController = null;

    if (window.innerWidth < 768) return;

    const nav = document.getElementById('desktop-nav') as HTMLElement | null;
    const indicator = document.getElementById(
      'navbar-fluid-indicator'
    ) as HTMLElement | null;
    const header = document.getElementById('site-header');
    if (!nav || !indicator) return;

    const links = Array.from(
      nav.querySelectorAll<HTMLAnchorElement>('.nav-link')
    );
    if (links.length === 0) return;

    if (window.scrollY < 120) {
      header?.setAttribute('data-hero-active', 'true');
    }

    scrollSpyController = initFluidScrollSpy({
      container: nav,
      links,
      indicator,
      headerOffset: 100,
      fadeDistance: 160,
      onUpdate: (result) => {
        if (result.isHero) {
          header?.setAttribute('data-hero-active', 'true');
        } else {
          header?.removeAttribute('data-hero-active');
        }
      },
    });
  }

  function setupDesktopDock() {
    dockController?.destroy();
    dockController = null;

    if (window.innerWidth < 1024) return;

    const header = document.getElementById('site-header');
    if (!header) return;

    const dragHandle = document.getElementById('dock-drag-handle');
    const menuBtn = document.getElementById('dock-menu-btn');
    const menuPopover = document.getElementById('dock-menu-popover');

    dockController = initDockManager({
      header,
      dragHandle,
      menuButton: menuBtn,
      menuPopover,
      onPositionChange: () => {
        scrollSpyController?.refresh();
      },
    });
  }

  function setupAllDesktopNav() {
    setupDesktopScrollSpy();
    setupDesktopDock();
  }

  setupAllDesktopNav();
  document.addEventListener('astro:after-swap', setupAllDesktopNav);

  const desktopMq = window.matchMedia('(min-width: 768px)');
  desktopMq.addEventListener('change', (e) => {
    if (e.matches) {
      setupDesktopScrollSpy();
    } else {
      scrollSpyController?.destroy();
      scrollSpyController = null;
    }
  });

  const desktopDockMq = window.matchMedia('(min-width: 1024px)');
  desktopDockMq.addEventListener('change', (e) => {
    if (e.matches) {
      setupDesktopDock();
    } else {
      dockController?.destroy();
      dockController = null;
      const header = document.getElementById('site-header');
      header?.setAttribute('data-dock', 'top');
    }
  });
</script>

<style>
  .nav-link {
    --nav-glow: 0;
  }
  .nav-link .nav-link-text {
    color: color-mix(
      in srgb,
      var(--color-accent) calc(var(--nav-glow, 0) * 100%),
      currentColor
    );
    text-shadow: 0 0 calc(var(--nav-glow, 0) * 8px) var(--color-accent-glow);
  }
  .nav-link .nav-icon {
    color: color-mix(
      in srgb,
      var(--color-accent) calc(var(--nav-glow, 0) * 100%),
      currentColor
    );
    filter: drop-shadow(
      0 0 calc(var(--nav-glow, 0) * 6px) var(--color-accent-glow)
    );
  }
  .nav-link[data-active='true'] {
    color: var(--color-accent);
  }
  .nav-link[data-active='true'] .nav-icon {
    color: var(--color-accent);
  }

  /* Dedicated Document Chromatic Identity for CV Button */
  .cv-btn {
    color: #4f46e5;
    background: rgba(79, 70, 229, 0.08);
    border-color: rgba(79, 70, 229, 0.22);
  }
  :global(.dark) .cv-btn {
    color: #818cf8;
    background: rgba(99, 102, 241, 0.12);
    border-color: rgba(99, 102, 241, 0.25);
  }
  .cv-btn:hover {
    background: #4f46e5;
    color: #ffffff;
    border-color: transparent;
    box-shadow: 0 0 14px rgba(79, 70, 229, 0.35);
  }
  :global(.dark) .cv-btn:hover {
    background: #6366f1;
    color: #ffffff;
    border-color: transparent;
    box-shadow: 0 0 14px rgba(99, 102, 241, 0.45);
  }

  /* Desktop Metamorphic Dock Positions & Geometry (>= 1024px) */
  @media (min-width: 1024px) {
    #site-header {
      transition:
        transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
        border-radius 0.3s ease,
        box-shadow 0.3s ease,
        background-color 0.3s ease;
    }

