---
import { cvData } from '@/data/cv-data';
import { FileDown } from 'lucide-astro';
import ThemeToggle from '@/components/portfolio/ThemeToggle.astro';

const { personal } = cvData;
---

<header class="sticky top-0 z-50 w-full border-b border-zinc-200/80 dark:border-zinc-800/80 bg-white/80 dark:bg-zinc-950/75 backdrop-blur-md">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <a
      href={import.meta.env.BASE_URL}
      class="group flex items-center gap-2.5 font-semibold text-zinc-900 dark:text-zinc-100 hover:text-zinc-950 dark:hover:text-white transition-colors"
      aria-label={`Inicio - Portfolio de ${personal.name}`}
    >
      <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-accent)] shadow-[0_0_8px_var(--color-accent-glow)]"></span>
      <span class="text-sm sm:text-base font-bold tracking-tight">Portfolio</span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-2.5 text-xs sm:text-sm font-medium text-zinc-600 dark:text-zinc-400">
      <a
        href="#proyectos"
        class="hidden sm:inline-block px-2.5 py-1.5 rounded-md hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/50 dark:hover:bg-zinc-900/60 transition-colors"
      >
        Proyectos
      </a>
      <a
        href="#trayectoria"
        class="hidden sm:inline-block px-2.5 py-1.5 rounded-md hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/50 dark:hover:bg-zinc-900/60 transition-colors"
      >
        Trayectoria
      </a>
      <a
        href="#certificaciones"
        class="hidden md:inline-block px-2.5 py-1.5 rounded-md hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/50 dark:hover:bg-zinc-900/60 transition-colors"
      >
        Certificaciones
      </a>
      <a
        href="#filosofia"
        class="hidden md:inline-block px-2.5 py-1.5 rounded-md hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/50 dark:hover:bg-zinc-900/60 transition-colors"
      >
        Filosofía
      </a>
      <a
        href="#contacto"
        class="hidden md:inline-block px-2.5 py-1.5 rounded-md hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/50 dark:hover:bg-zinc-900/60 transition-colors"
      >
        Contacto
      </a>
      <a
        href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/cv`}
        class="inline-flex items-center gap-1.5 ml-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-zinc-100 dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 border border-zinc-300 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-700 hover:bg-zinc-200 dark:hover:bg-zinc-800 hover:text-zinc-950 dark:hover:text-white transition-all shadow-xs"
      >
        <FileDown class="w-3.5 h-3.5 text-[var(--color-accent)]" />
        <span>CV PDF</span>
      </a>

      <!-- Theme & Accent Controls -->
      <ThemeToggle />
    </nav>
  </div>
</header>
