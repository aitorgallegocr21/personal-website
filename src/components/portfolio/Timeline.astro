---
import { cvData } from '@/data/cv-data';
import { MapPin, FileText } from 'lucide-astro';

const { experience, education } = cvData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

interface TimelineEntry {
  id: string;
  role: string;
  organization: string;
  period: string;
  location?: string;
  category: 'tech' | 'education' | 'complementary';
  badge: string;
  description?: string;
  bullets?: string[];
  technologies?: string[];
  documentUrl?: string;
}

const ntt = experience.find((e) => e.id === 'ntt-data');
const dam = education.find((e) => e.degree.includes('DAM'));
const smr = education.find((e) => e.degree.includes('SMR'));
const hermogenes = experience.find((e) => e.id === 'ies-hermogenes');
const tenis = experience.find((e) => e.id === 'clases-tenis');
const hosteleria = experience.find((e) => e.id === 'hosteleria');

const timelineItems: TimelineEntry[] = [
  ...(dam
    ? [
        {
          id: 'edu-dam',
          role: dam.degree,
          organization: dam.institution,
          period: dam.period,
          category: 'education' as const,
          badge: 'Formación Superior',
          bullets: dam.details,
          documentUrl: dam.documentUrl,
        },
      ]
    : []),
  ...(hosteleria
    ? [
        {
          id: hosteleria.id,
          role: hosteleria.role,
          organization: hosteleria.company,
          period: '05/2026 — 08/2026',
          location: hosteleria.location,
          category: 'complementary' as const,
          badge: 'Atención & Gestión',
          description: hosteleria.description,
          bullets: hosteleria.bullets,
          technologies: hosteleria.technologies,
        },
      ]
    : []),
  ...(ntt
    ? [
        {
          id: ntt.id,
          role: ntt.role,
          organization: ntt.company,
          period: '03/2026 — 04/2026',
          location: ntt.location,
          category: 'tech' as const,
          badge: 'Desarrollo & Backend',
          description: ntt.description,
          bullets: ntt.bullets,
          technologies: ntt.technologies,
        },
      ]
    : []),
  ...(tenis
    ? [
        {
          id: tenis.id,
          role: tenis.role,
          organization: tenis.company,
          period: '09/2025 — Actualidad',
          location: tenis.location,
          category: 'complementary' as const,
          badge: 'Docencia & Coaching',
          description: tenis.description,
          bullets: tenis.bullets,
          technologies: tenis.technologies,
        },
      ]
    : []),
  ...(hermogenes
    ? [
        {
          id: hermogenes.id,
          role: hermogenes.role,
          organization: hermogenes.company,
          period: '03/2025 — 06/2025',
          location: hermogenes.location,
          category: 'tech' as const,
          badge: 'Sistemas & Redes',
          description: hermogenes.description,
          bullets: hermogenes.bullets,
          technologies: hermogenes.technologies,
        },
      ]
    : []),
  ...(smr
    ? [
        {
          id: 'edu-smr',
          role: smr.degree,
          organization: smr.institution,
          period: smr.period,
          category: 'education' as const,
          badge: 'Formación Técnica',
          bullets: smr.details,
          documentUrl: smr.documentUrl,
        },
      ]
    : []),
];
---

<section id="trayectoria" class="py-12 sm:py-16 scroll-mt-20">
  <div class="mb-10">
    <div class="inline-flex items-center gap-2 font-mono text-xs text-[var(--color-accent)] font-semibold tracking-wider uppercase mb-1">
      <span>// Experiencia &amp; Educación</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      Trayectoria &amp; Formación
    </h2>
    <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 mt-1 max-w-xl">
      Itinerario cronológico en desarrollo de software, administración de sistemas, especialización técnica y habilidades interpersonales.
    </p>
  </div>

  <div class="relative border-l border-zinc-200 dark:border-zinc-800 ml-3 sm:ml-4 pl-6 sm:pl-8 space-y-10 sm:space-y-12">
    {
      timelineItems.map((item) => (
        <article class="relative group">
          <!-- Node dot indicator -->
          <span
            class:list={[
              'absolute -left-[31px] sm:-left-[39px] mt-1.5 flex h-3.5 w-3.5 rounded-full border-2 border-white dark:border-zinc-950 transition-transform duration-200 group-hover:scale-125',
              item.category === 'tech'
                ? 'bg-[var(--color-accent)]'
                : item.category === 'education'
                  ? 'bg-sky-500'
                  : 'bg-zinc-400',
            ]}
            aria-hidden="true"
          />

          <!-- Metadata row: Date, badge, location -->
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400 font-medium">
              {item.period}
            </span>
            <span
              class:list={[
                'font-mono text-[11px] px-2 py-0.5 rounded-md border',
                item.category === 'tech'
                  ? 'bg-[var(--color-accent-subtle)] text-[var(--color-accent)] border-[var(--color-accent-border)]'
                  : item.category === 'education'
                    ? 'bg-sky-500/10 text-sky-600 dark:text-sky-300 border-sky-500/20'
                    : 'bg-zinc-100 dark:bg-zinc-800/60 text-zinc-700 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700/50',
              ]}
            >
              {item.badge}
            </span>
            {item.location && (
              <span class="inline-flex items-center gap-1 text-xs text-zinc-500 dark:text-zinc-500 font-mono">
                <MapPin class="w-3 h-3 text-zinc-400 dark:text-zinc-500" />
                <span>{item.location}</span>
              </span>
            )}
          </div>

          <!-- Role & Organization -->
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2">
            <h3 class="text-base sm:text-lg font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors">
              {item.role}
            </h3>
            <span class="text-sm font-medium text-zinc-500 dark:text-zinc-400">
              · {item.organization}
            </span>
          </div>

          <!-- Description -->
          {item.description && (
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2.5 max-w-2xl">
              {item.description}
            </p>
          )}

          <!-- Bullets -->
          {item.bullets && item.bullets.length > 0 && (
            <ul class="space-y-1.5 mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400/90 max-w-2xl">
              {item.bullets.map((bullet) => (
                <li class="flex items-start gap-2">
                  <span class="text-[var(--color-accent)] select-none mt-0.5 leading-none font-bold">›</span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          )}

          <!-- Document Credential Trigger -->
          {item.documentUrl && (
            <div class="mt-3.5">
              <button
                type="button"
                data-doc-url={`${baseUrl}${item.documentUrl}`}
                data-doc-title={item.role}
                data-doc-subtitle={`${item.organization} · ${item.period}`}
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium text-[var(--color-accent)] bg-[var(--color-accent-subtle)] hover:bg-[var(--color-accent)] hover:text-white border border-[var(--color-accent-border)] transition-all cursor-pointer"
                aria-label={`Ver documento oficial de ${item.role}`}
              >
                <FileText class="w-3.5 h-3.5" />
                <span>Ver documento oficial</span>
              </button>
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>
