---
import { cvData } from '@/data/cv-data';
import { Award, CheckCircle2, FileText } from 'lucide-astro';

const { certificates } = cvData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const categories = [
  'Todas',
  'Java & Backend',
  'Frontend',
  'Bases de Datos',
  'Inteligencia Artificial',
] as const;
---

<section id="certificaciones" class="py-12 sm:py-16 scroll-mt-20">
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 font-mono text-xs text-[var(--color-accent)] font-semibold tracking-wider uppercase mb-1">
      <span>// Certificaciones &amp; Acreditaciones</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      Certificaciones Técnicas
    </h2>
    <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 mt-1 max-w-xl">
      Especializaciones formativas y competencias técnicas avaladas por NTT DATA y entidades del sector tecnológico.
    </p>
  </div>

  <!-- Category filter buttons -->
  <div class="flex flex-wrap items-center gap-2 mb-8" role="tablist" aria-label="Filtrar certificaciones por categoría">
    {
      categories.map((cat, index) => {
        const count =
          cat === 'Todas'
            ? certificates.length
            : certificates.filter((c) => c.category === cat).length;

        return (
          <button
            type="button"
            class:list={[
              'cert-filter-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-all duration-200 cursor-pointer border',
              index === 0
                ? 'active bg-[var(--color-accent)] text-[var(--color-accent-contrast)] border-[var(--color-accent)] font-semibold shadow-xs ring-1 ring-[var(--color-accent-border)]'
                : 'bg-zinc-100 dark:bg-zinc-900/60 text-zinc-600 dark:text-zinc-400 border-zinc-200 dark:border-zinc-800 hover:text-[var(--color-accent)] dark:hover:text-[var(--color-accent)] hover:border-[var(--color-accent-border)] hover:bg-[var(--color-accent-subtle)]',
            ]}
            data-filter={cat}
          >
            <span>{cat}</span>
            <span
              class:list={[
                'cert-filter-count text-[10px] px-1.5 py-0.2 rounded-full font-mono transition-colors',
                index === 0
                  ? 'bg-black/20 text-[var(--color-accent-contrast)]'
                  : 'bg-zinc-200 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400',
              ]}
            >
              {count}
            </span>
          </button>
        );
      })
    }
  </div>

  <!-- Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6" id="certifications-grid">
    {
      certificates.map((cert) => (
        <article
          class="cert-card group relative flex flex-col justify-between rounded-xl border border-zinc-200 dark:border-zinc-800/80 bg-white/70 dark:bg-zinc-900/40 p-5 sm:p-6 backdrop-blur-sm transition-all duration-300 hover:border-[var(--color-accent)]/50 hover:bg-white dark:hover:bg-zinc-900/70 hover:shadow-xl hover:shadow-[var(--color-accent-glow)]/10 hover:-translate-y-0.5"
          data-category={cert.category}
        >
          <div>
            <!-- Top badges row: Issuer & Category/Hours -->
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-0.5 rounded-md bg-[var(--color-accent-subtle)] text-[var(--color-accent)] border border-[var(--color-accent-border)]">
                  <Award class="w-3.5 h-3.5" />
                  <span>{cert.issuer}</span>
                </span>
                {cert.documents && cert.documents.length > 1 && (
                  <span class="inline-flex items-center gap-1 font-mono text-[10px] px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700/60 font-medium">
                    <span>{cert.documents.length} PDFs</span>
                  </span>
                )}
              </div>

              <div class="flex items-center gap-1.5 font-mono text-[11px] text-zinc-500 dark:text-zinc-400">
                {cert.hours && <span>{cert.hours}</span>}
                {cert.hours && cert.platform && <span>·</span>}
                {cert.platform && <span>{cert.platform}</span>}
              </div>
            </div>

            <!-- Title -->
            <h3 class="text-base sm:text-lg font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-[var(--color-accent)] transition-colors mb-2">
              {cert.title}
            </h3>

            <!-- Summary -->
            {cert.summary && (
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
                {cert.summary}
              </p>
            )}
          </div>

          <!-- Bottom Row: Skills tags & Document preview button -->
          <div class="pt-3 border-t border-zinc-200 dark:border-zinc-800/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            {cert.skills && cert.skills.length > 0 && (
              <div class="flex flex-wrap gap-1.5 flex-1">
                {cert.skills.map((skill) => (
                  <span class="inline-flex items-center gap-1 font-mono text-[11px] px-2 py-0.5 rounded bg-zinc-100/70 dark:bg-zinc-800/40 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-800 transition-all duration-200 hover:border-[var(--color-accent-border)] hover:bg-[var(--color-accent-subtle)] hover:text-[var(--color-accent)] select-none">
                    <CheckCircle2 class="w-2.5 h-2.5 text-[var(--color-accent)]" />
                    <span>{skill}</span>
                  </span>
                ))}
              </div>
            )}

            {(cert.documentUrl || (cert.documents && cert.documents.length > 0)) && (
              <button
                type="button"
                data-doc-url={cert.documentUrl ? `${baseUrl}${cert.documentUrl}` : `${baseUrl}${cert.documents![0].url}`}
                data-doc-title={cert.title}
                data-doc-subtitle={`${cert.issuer} · ${cert.category}`}
                data-docs={cert.documents ? JSON.stringify(cert.documents.map((d) => ({ title: d.title, url: `${baseUrl}${d.url}`, type: d.type }))) : ''}
                class="inline-flex items-center justify-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium text-[var(--color-accent)] bg-[var(--color-accent-subtle)] hover:bg-[var(--color-accent)] hover:text-[var(--color-accent-contrast)] border border-[var(--color-accent-border)] hover:scale-[1.02] active:scale-[0.98] hover:shadow-xs transition-all cursor-pointer shrink-0 self-start sm:self-auto font-medium"
                aria-label={`Ver credencial de ${cert.title}`}
              >
                <FileText class="w-3.5 h-3.5" />
                <span>
                  {cert.documents && cert.documents.length > 1
                    ? `Ver documentos (${cert.documents.length})`
                    : 'Ver credencial'}
                </span>
              </button>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.cert-filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.cert-card');

  const activeClasses = [
    'active',
    'bg-[var(--color-accent)]',
    'text-[var(--color-accent-contrast)]',
    'border-[var(--color-accent)]',
    'font-semibold',
    'shadow-xs',
    'ring-1',
    'ring-[var(--color-accent-border)]',
  ];

  const inactiveClasses = [
    'bg-zinc-100',
    'dark:bg-zinc-900/60',
    'text-zinc-600',
    'dark:text-zinc-400',
    'border-zinc-200',
    'dark:border-zinc-800',
    'font-medium',
  ];

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');
      if (!filter) return;

      // Update active button state
      buttons.forEach((b) => {
        const isCurrent = b === btn;
        const countSpan = b.querySelector('.cert-filter-count');

        if (isCurrent) {
          b.classList.remove(...inactiveClasses);
          b.classList.add(...activeClasses);
          if (countSpan) {
            countSpan.classList.remove('bg-zinc-200', 'dark:bg-zinc-800', 'text-zinc-600', 'dark:text-zinc-400');
            countSpan.classList.add('bg-black/20', 'text-[var(--color-accent-contrast)]');
          }
        } else {
          b.classList.remove(...activeClasses);
          b.classList.add(...inactiveClasses);
          if (countSpan) {
            countSpan.classList.remove('bg-black/20', 'text-[var(--color-accent-contrast)]');
            countSpan.classList.add('bg-zinc-200', 'dark:bg-zinc-800', 'text-zinc-600', 'dark:text-zinc-400');
          }
        }
      });

      // Show/hide cards
      cards.forEach((card) => {
        const category = card.getAttribute('data-category');
        if (filter === 'Todas' || category === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>
