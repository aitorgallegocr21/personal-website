# Global Security Headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';

# Static Assets Caching (immutable Vite/Astro bundles)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static Media & Document Assets Caching
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/docs/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/cv/*.pdf
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
